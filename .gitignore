# 依赖与工具产物
node_modules/
*.log
*.err
.env
# 退役/暂关素材备份（3D 版暂无此目录，预防性声明，与主仓口径一致）
_backup/
# 一次性门禁 / 模拟 / 渲染日志（显式列出便于审计）
tools/_mc-*.log
tools/_hires-*.log
tools/_sdxl-*.log
tools/_qwen-rooms-*.log

# 系统垃圾文件
.DS_Store
Thumbs.db
desktop.ini
# 演示视频等大体积媒体：只在本地留档，不入库、不上传远端（2026-11-12 用户裁定）
*.mp4

# ---- Godot 本机缓存与截图（可再生成，随盘保留、不入库）----
3d/preview/.godot/
3d/preview/screenshots/
3d/preview/scripts/_*.gd
3d/preview/scripts/_*.gd.uid
3d/tools/_*.cjs
3d/tools/_*shots/

# ---- Python / 工具临时产物 ----
__pycache__/
*.pyc
3d/tools/__pycache__/
3d/tools/_bak/
tools/__pycache__/
tools/_bak/
tools/screenshots/
tools/_*.png
tools/_shot*.png
tools/_zoom*.png
tools/_gate-*.log
tools/_mc-*.json
tools/_mc-*.md
tools/_*.cjs
tools/_diag*.cjs

# ---- 2.5D 烘焙源材质（沿用原仓口径）----
# 3D 侧同款贴图走 3d/preview/assets/textures；door-panel.png 是运行时依赖，保留入库。
assets/scene/v4/tex/*
!assets/scene/v4/tex/door-panel.png
assets/scene/v4/facility/_raw/
assets/scene/v4/facility/_raw_fx/

# ---- 大体积可再生物：随盘保留、不入库（沿用原仓「出仓」策略）----
# 说明：文件都在磁盘上，Godot 直接可跑；如需把资产纳入版本控制，删掉对应行即可。
3d/preview/assets/textures/
3d/assets/renders/
3d/assets/refs/
# 素材库 PNG 为 L1 构建期源，不入库；README.md 与 素材库清单.json 必须入库（与主仓口径一致）
assets/qwen-lib/*.png
tools/_qwen_refs/
# docs/qwen21/ 为千问出图留档（L2 中间产物），新增不入库；
# 主仓历史已入库的 88 个文件待保留期评估，口径见 docs/ASSET_GOVERNANCE.md §7-C
docs/qwen21/
*.blend1

# 蒙特卡洛原始局（基线工具产物）
tools/mc-results.json
tools/mc-results-E.json

# 生成报告：本机可重跑，不入库（数据夹具 js-simdump 除外）
3d/reports/*.md
3d/reports/*.csv
3d/reports/*.json
!3d/reports/js-simdump-20261108.json
