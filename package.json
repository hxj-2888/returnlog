    "3d:pages:bind": "node 3d/tools/ensure-pages-project.cjs",
    "3d:port:check": "node 3d/tools/check-port-manifest.cjs",
    "3d:events:check": "node 3d/tools/check-events.cjs",
    "3d:lines:check": "node 3d/tools/check-lines.cjs",
