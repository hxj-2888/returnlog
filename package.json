{
  "name": "returnlog",
  "displayName": "新返航录",
  "version": "3.7.0",
  "gameVersion": "返航录V3.7",
  "description": "《新返航录》网页试玩版 · 返航录V3——11 人类 vs 4 异形的实时太空船对抗游戏（零依赖前端，file:// 可直接运行）",
  "author": "hxj-2888",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/hxj-2888/returnlog",
  "repository": {
    "type": "git",
    "url": "https://github.com/hxj-2888/returnlog.git"
  },
  "scripts": {
    "start": "node tools/serve.cjs",
    "dev": "node tools/serve.cjs",
    "guard": "node tools/asset-guard.cjs",
    "guard:expired": "node tools/asset-guard.cjs --expired",
    "agent:contract": "node tools/check-agent-contract.cjs",
    "test": "node tools/test-v3.cjs",
    "sim": "node tools/monte-carlo.cjs",
    "ship": "node tools/ship.cjs",
    "ship:fast": "node tools/ship.cjs --fast",
    "ship:web": "node tools/ship.cjs --only=web,portfolio",
    "plate:build": "node tools/plate/build.cjs",
    "plate:check": "node tools/plate/validate.cjs",
    "3d:assets": "node 3d/tools/validate-assets.cjs",
    "3d:sync:models": "node 3d/tools/sync-models.cjs",
    "3d:import:check": "node 3d/tools/check-godot-import.cjs",
    "3d:export:map": "node 3d/tools/export-map.cjs",
    "3d:export:minigames": "node 3d/tools/export-minigames.cjs",
    "3d:export:space": "node 3d/tools/export-space.cjs",
    "3d:export:sim": "node 3d/tools/export-sim.cjs",
    "3d:export:lines": "node 3d/tools/export-lines.cjs",
    "3d:export:version": "node 3d/tools/export-version.cjs",
    "3d:export:rules": "node 3d/tools/export-rules.cjs",
    "3d:simdump": "node 3d/tools/simdump.cjs",
    "3d:port:check": "node 3d/tools/check-port-manifest.cjs",
    "3d:events:check": "node 3d/tools/check-events.cjs",
    "3d:lines:check": "node 3d/tools/check-lines.cjs",
    "3d:parity:check": "node 3d/tools/check-parity.cjs",
    "3d:refs:cabin": "pwsh -NoProfile -ExecutionPolicy Bypass -File 3d/tools/gen-art-refs.ps1 -Set cabin",
    "3d:refs:tasks": "pwsh -NoProfile -ExecutionPolicy Bypass -File 3d/tools/gen-art-refs.ps1 -Set tasks"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
