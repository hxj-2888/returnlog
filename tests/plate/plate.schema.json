{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "图内要素板（plate）",
  "description": "描述一张可直接操控的面板图：像素坐标里的线/断口，或若干可点热点。运行时代理真源为 js/data/plates.js。",
  "type": "object",
  "required": ["id", "label", "image", "size", "crop"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "image": { "type": "string", "minLength": 1, "description": "相对仓库根目录的图片路径" },
    "size": {
      "type": "array", "items": { "type": "integer", "minimum": 1 },
      "minItems": 2, "maxItems": 2
    },
    "crop": {
      "type": "array", "items": { "type": "number", "minimum": 0 },
      "minItems": 4, "maxItems": 4,
      "description": "显示时放大哪一块：[x, y, w, h]，单位同 size"
    },
    "skin": {
      "type": "string", "enum": ["cut", "dirty", "off"],
      "description": "未完成处的视觉皮肤：破损 / 污渍 / 断电"
    },
    "cut": {
      "type": "object", "required": ["w", "h"], "additionalProperties": false,
      "properties": {
        "w": { "type": "number", "minimum": 4 },
        "h": { "type": "number", "minimum": 4 }
      }
    },
    "ember": {
      "type": "object", "required": ["r", "hit"], "additionalProperties": false,
      "properties": {
        "r": { "type": "number", "minimum": 1 },
        "hit": { "type": "number", "minimum": 4 }
      }
    },
    "wires": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/definitions/wire" }
    },
    "spots": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/definitions/spot" }
    },
    "lanes": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/definitions/lane" }
    }
  },
  "definitions": {
    "lane": {
      "type": "object",
      "required": ["x", "y", "w", "h", "band", "period"],
      "additionalProperties": false,
      "description": "节奏点按的轨道：准星在 band 区间内时点击算命中",
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "minimum": 8 },
        "h": { "type": "number", "minimum": 8 },
        "band": {
          "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 2, "maxItems": 2
        },
        "period": { "type": "number", "minimum": 0.4, "maximum": 8 }
      }
    },
    "wire": {
      "type": "object",
      "required": ["id", "color", "width", "path", "cut"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "width": { "type": "number", "minimum": 1 },
        "path": { "type": "string", "pattern": "^M[0-9]" },
        "cut": {
          "type": "object", "required": ["x", "y", "angle"], "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "angle": { "type": "number", "minimum": -360, "maximum": 360 }
          }
        }
      }
    },
    "spot": {
      "type": "object",
      "required": ["id", "shape", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "shape": { "type": "string", "enum": ["rect", "circle", "point"] },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 },
        "r": { "type": "number", "minimum": 1 },
        "role": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "fx": {
          "type": "object",
          "description": "完成态的图内位移：把这个热点的一块贴图搬走 / 旋开 / 压下（dx、dy 是热点框宽高的比例）",
          "additionalProperties": false,
          "properties": {
            "k": { "type": "string", "enum": ["press", "turn", "slide", "lit"] },
            "clip": { "type": "string", "enum": ["rect", "circle"] },
            "dx": { "type": "number", "minimum": -2, "maximum": 2 },
            "dy": { "type": "number", "minimum": -2, "maximum": 2 },
            "s": { "type": "number", "minimum": 0.1, "maximum": 2 },
            "deg": { "type": "number", "minimum": -360, "maximum": 360 },
            "dim": { "type": "number", "minimum": 0, "maximum": 1 },
            "lit": { "type": "number", "minimum": 0.5, "maximum": 3 },
            "glow": { "type": "boolean" }
          }
        },
        "reveals": { "type": "string" },
        "band": {
          "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 100 },
          "minItems": 2, "maxItems": 2,
          "description": "长按到位的亮带：[下沿%, 上沿%]，按热点高度自底向上"
        },
        "hold": { "type": "number", "minimum": 0.2, "maximum": 6 },
        "to": {
          "type": "array", "items": { "type": "number", "minimum": 0 },
          "minItems": 2, "maxItems": 2,
          "description": "拖动目标中心（图片像素）"
        },
        "toR": { "type": "number", "minimum": 8 },
        "hole": {
          "type": "object", "required": ["x", "y", "w", "h"], "additionalProperties": false,
          "description": "遮罩洞开在哪：不写时=热点本身；拖动类任务开在缺口上",
          "properties": {
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "w": { "type": "number", "minimum": 4 },
            "h": { "type": "number", "minimum": 4 }
          }
        }
      }
    }
  }
}
