{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://returnlog.local/3d/asset.schema.json",
  "title": "启航路 3D 版 · 资产清单 schema",
  "description": "3d/spec/assets.manifest.json 的结构约束。校验脚本 tools/validate-assets.cjs 按这份文件实现（不依赖 ajv）。",
  "type": "object",
  "required": [
    "version",
    "unit",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "unit": {
      "const": "meter"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/asset"
      }
    }
  },
  "definitions": {
    "asset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "status",
        "source",
        "export",
        "budget",
        "pivot",
        "collision",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,39}$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "category": {
          "enum": [
            "ship",
            "room",
            "prop",
            "device",
            "character",
            "fx"
          ]
        },
        "status": {
          "enum": [
            "todo",
            "wip",
            "done",
            "blocked"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^models/[a-z0-9_]+\\.blend$"
        },
        "export": {
          "type": "string",
          "pattern": "^export/[a-z0-9_]+\\.glb$"
        },
        "budget": {
          "type": "object",
          "required": [
            "tris",
            "materials"
          ],
          "additionalProperties": false,
          "properties": {
            "tris": {
              "type": "integer",
              "minimum": 2
            },
            "materials": {
              "type": "integer",
              "minimum": 1
            },
            "textures": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "pivot": {
          "enum": [
            "origin",
            "base_center",
            "socket"
          ]
        },
        "collision": {
          "enum": [
            "none",
            "box",
            "convex",
            "mesh"
          ]
        },
        "lod": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "textures": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^textures/[a-z0-9_]+\\.png$"
          }
        },
        "room": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "minLength": 2
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
